# FaultDx Phase 1 environment example
# Copy this file to .env and fill in values for your machine.
# Never commit .env — only .env.example belongs in Git.
# Values here are non-sensitive placeholders only.

# ── Runtime ────────────────────────────────────────────────────────────────────
FAULTDX_ENV=dev                  # dev | local_gpu | server
FAULTDX_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ── Provider type ──────────────────────────────────────────────────────────────
# stub      → no real inference; use for E1 daily dev and unit tests
# ollama    → local Ollama instance; use for E2 local GPU machines
# company_api → internal LLM API endpoint; use for E3 server runs
FAULTDX_PROVIDER_TYPE=stub

# ── Ollama (E2 — local GPU machines, Windows) ──────────────────────────────────
FAULTDX_OLLAMA_ENDPOINT=http://localhost:11434
FAULTDX_OLLAMA_MODEL=qwen2.5:7b
FAULTDX_OLLAMA_TIMEOUT=300        # seconds; default 120 — increase for cold-start or large prompts

# Custom Ollama model storage directory.
# E2a (custom path): set to the actual models dir, e.g. D:\Ollama\models
# E2b (default path): leave empty — Ollama uses its built-in default (~/.ollama/models)
# This maps to the OLLAMA_MODELS env var that must be set BEFORE starting ollama serve.
FAULTDX_OLLAMA_MODELS_DIR=

# Ollama parallelism tuning (optional; leave empty to use Ollama defaults)
# E2a recommended: NUM_PARALLEL=2, MAX_LOADED_MODELS=1, MAX_QUEUE=128
FAULTDX_OLLAMA_NUM_PARALLEL=
FAULTDX_OLLAMA_MAX_LOADED_MODELS=
FAULTDX_OLLAMA_MAX_QUEUE=

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Company LLM API (E3 — Ubuntu test server) ─────────────────────────────────
FAULTDX_COMPANY_API_BASE=https://your-llm-api.example.com/v1
FAULTDX_COMPANY_API_KEY=your_api_key_here
FAULTDX_COMPANY_MODEL_NAME=your_model_name_here

# ── Neo4j ──────────────────────────────────────────────────────────────────────
FAULTDX_NEO4J_HOST=bolt://127.0.0.1:7687
FAULTDX_NEO4J_USER=neo4j
FAULTDX_NEO4J_PASSWORD=your_password_here
FAULTDX_NEO4J_DATABASE=neo4j

# ── GraphRAG ───────────────────────────────────────────────────────────────────
FAULTDX_GRAPHRAG_ROOT=./data/graphrag

# ── Masking pipeline ──────────────────────────────────────────────────────────
# Salt for deterministic tokenization / hashing in the masking pipeline.
# Required: pipeline refuses to run without it. Generate a random string.
FAULTDX_MASKING_SALT=change-me-to-a-random-secret

# ── Data roots ─────────────────────────────────────────────────────────────────
FAULTDX_DATA_RAW=./data/raw
FAULTDX_DATA_PROCESSED=./data/processed
FAULTDX_DATA_SERVING_STRUCTURED=./data/serving_structured
FAULTDX_DATA_SERVING_UNSTRUCTURED=./data/serving_unstructured
FAULTDX_DATA_EVAL=./data/eval
