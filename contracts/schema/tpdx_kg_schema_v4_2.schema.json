{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tpdx_kg_schema_v4_2",
  "title": "FaultDx TPDX KG Schema 4.2 Ingestion Contract",
  "description": "FROZEN self-contained Route A contract adding MappingRecord-backed diagnostic-chain assertion projections to the frozen Schema 4.1 topology and diagnostic model.",
  "x-contract-status": "FROZEN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload_kind",
    "nodes",
    "edges",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": "4.2"
    },
    "payload_kind": {
      "type": "string",
      "enum": [
        "topology",
        "diagnostic",
        "combined"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payload_kind": {
            "const": "topology"
          }
        },
        "required": [
          "payload_kind"
        ]
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/$defs/topology_node"
            }
          },
          "edges": {
            "items": {
              "$ref": "#/$defs/topology_edge"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload_kind": {
            "const": "diagnostic"
          }
        },
        "required": [
          "payload_kind"
        ]
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/$defs/diagnostic_node"
            }
          },
          "edges": {
            "items": {
              "$ref": "#/$defs/diagnostic_edge"
            }
          }
        }
      }
    }
  ],
  "x-graph-invariants": [
    "All frozen Schema 4.1 topology, node, MappingRecord, scope, replacement, identity, exclusion, and query-entry invariants remain in force unless this contract explicitly replaces a relationship rule.",
    "FP, EC, RC, RA, and RS are abbreviations for Phenomenon, ErrorCode, Cause, Action, and ActionStep; they are not additional node labels.",
    "MappingRecord remains the first-class governed assertion carrying source, topology scope, review, serving, and promotion state.",
    "HAS_CODE, HAS_CAUSE, HAS_ACTION, and HAS_STEPS are stored assertion projections and do not replace MappingRecord membership edges.",
    "Every assertion projection has one deterministic assertion_edge_id and one backing mapping_record_id.",
    "The backing MappingRecord and its required membership edges must resolve in the validated bundle or explicitly supplied governed graph context.",
    "HAS_CODE requires the backing MappingRecord to OBSERVES the source Phenomenon and USES_ERROR_CODE the target ErrorCode.",
    "HAS_CAUSE requires the backing MappingRecord to OBSERVES the source Phenomenon and ASSERTS_CAUSE the target Cause.",
    "HAS_ACTION requires the backing MappingRecord to ASSERTS_CAUSE the source Cause and RECOMMENDS_ACTION the target Action.",
    "HAS_ACTION requires a non-empty cause_action_pair_id identifying the reviewed source pairing; this evidence must not be synthesized from independent memberships.",
    "HAS_STEPS requires the backing MappingRecord to RECOMMENDS_ACTION the source Action.",
    "Cause-to-Action pairs must be explicitly source-supported; importers must never infer the Cartesian product of a MappingRecord's causes and actions.",
    "Independent MappingRecords supporting the same endpoint pair remain independent assertion projections and retain distinct assertion_edge_id values.",
    "HAS_STEP is not a stored Schema 4.2 relationship; frozen Schema 4.1 inputs require a migration adapter to HAS_STEPS.",
    "ActionStep order values are unique and contiguous from 1 within each Action after endpoint deduplication.",
    "Unbacked, contradictory, ambiguous, duplicate, or invalid projections appear in exclusions and are not silently published."
  ],
  "x-query-entry-contract": {
    "router_entry_labels": [
      "Module",
      "Component",
      "SubComponent"
    ],
    "assertion_scope_label": "Module",
    "resolution_modes": {
      "Module": "direct",
      "Component": "ancestor_module",
      "SubComponent": "ancestor_module"
    },
    "required_result_identity": [
      "query_entry_label",
      "query_entry_id",
      "assertion_scope_label",
      "assertion_scope_id",
      "scope_resolution"
    ],
    "stored_diagnostic_path": "MappingRecord-[:SCOPED_TO]->Module; MappingRecord-[:OBSERVES]->Phenomenon; Phenomenon-[:HAS_CAUSE]->Cause-[:HAS_ACTION]->Action-[:HAS_STEPS]->ActionStep; Phenomenon-[:HAS_CODE]->ErrorCode"
  },
  "x-identity-rules": {
    "mapping_record_identity_v1": {
      "inputs": [
        "source_id",
        "source_snapshot_id",
        "source_record_id",
        "SCOPED_TO.module_id",
        "OBSERVES.phenomenon_id"
      ],
      "delimiter": "U+001F",
      "digest": "SHA-256 lowercase hexadecimal",
      "output": "MR_<64 lowercase hexadecimal characters>",
      "excluded_mutable_fields": [
        "review_status",
        "serving_safe",
        "promotion_decision_id",
        "reviewed_by",
        "reviewed_at",
        "warnings"
      ]
    },
    "assertion_edge_identity_v1": {
      "inputs": [
        "relationship_type",
        "from_id",
        "to_id",
        "mapping_record_id"
      ],
      "delimiter": "U+001F",
      "digest": "SHA-256 lowercase hexadecimal",
      "output": "AE_<64 lowercase hexadecimal characters>"
    }
  },
