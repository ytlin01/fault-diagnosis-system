{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faultdx/contracts/evaluation/route_a_static_coverage_input_v1.schema.json",
  "title": "Route A static coverage input",
  "description": "DRAFT normalized graph snapshot for static coverage. It is an adapter artifact, not a domain-gold contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "nodes", "relations", "coverage_targets"],
  "properties": {
    "schema_version": {"const": "route_a_static_coverage_input_v1"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "graph_version", "snapshot_id", "data_maturity", "config_digest"], "properties": {"candidate_id": {"type": "string"}, "graph_version": {"type": "string"}, "snapshot_id": {"type": "string"}, "data_maturity": {"enum": ["assumed_label_provisional", "provisional", "reviewed"]}, "config_digest": {"type": "string"}}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "coverage_targets": {"$ref": "#/$defs/targets"}
  },
  "$defs": {
    "node": {"type": "object", "additionalProperties": false, "required": ["concept_id", "concept_type"], "properties": {"concept_id": {"type": "string", "minLength": 1}, "concept_type": {"type": "string", "minLength": 1}, "review_state": {"enum": ["pending", "reviewed", "adjudicated", "unknown"]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_id", "anchor", "review_state"], "properties": {"source_id": {"type": "string", "minLength": 1}, "anchor": {"type": "string", "minLength": 1}, "review_state": {"enum": ["pending", "reviewed", "adjudicated", "unknown"]}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["subject_id", "relation", "object_id"], "properties": {"subject_id": {"type": "string", "minLength": 1}, "relation": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "minLength": 1}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "targetRelation": {"type": "object", "additionalProperties": false, "required": ["subject_id", "relation", "object_id"], "properties": {"subject_id": {"type": "string"}, "relation": {"type": "string"}, "object_id": {"type": "string"}}},
    "targetPath": {"type": "object", "additionalProperties": false, "required": ["path_id", "kind", "edges"], "properties": {"path_id": {"type": "string"}, "kind": {"enum": ["topology", "diagnostic", "bridge"]}, "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/targetRelation"}}}},
    "targets": {"type": "object", "additionalProperties": false, "required": ["expected_entities", "expected_relations", "expected_paths"], "properties": {"expected_entities": {"type": "array", "items": {"$ref": "#/$defs/node"}}, "expected_relations": {"type": "array", "items": {"$ref": "#/$defs/targetRelation"}}, "expected_paths": {"type": "array", "items": {"$ref": "#/$defs/targetPath"}}, "bridge": {"type": "object", "additionalProperties": false, "properties": {"relation_types": {"type": "array", "items": {"type": "string"}}, "source_types": {"type": "array", "items": {"type": "string"}}}}, "provenance_required_relations": {"type": "array", "items": {"type": "string"}}}}
  }
}
